/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Agent working directory — never committed.
.claude/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Local scratch
coverage/
.eslintcache
*.bak
*.orig
